{
  "name": "RogueAbyss",
  "tree": {
    "$className": "DataModel",

    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/shared"
      },
      "Remotes": {
        "$className": "Folder",
        "RequestStrike": { "$className": "RemoteEvent" },
        "RequestUseItem": { "$className": "RemoteEvent" },
        "RequestLantern": { "$className": "RemoteEvent" },
        "RequestCreep": { "$className": "RemoteEvent" },
        "RequestRestart": { "$className": "RemoteEvent" },
        "RequestMenu": { "$className": "RemoteEvent" },
        "RequestInventory": { "$className": "RemoteEvent" },
        "RequestAbility": { "$className": "RemoteEvent" },
        "RequestPerk": { "$className": "RemoteEvent" },
        "ClientReady": { "$className": "RemoteEvent" },
        "AwaitGround": { "$className": "RemoteEvent" },
        "Vitals": { "$className": "RemoteEvent" },
        "GetProfile": { "$className": "RemoteFunction" },
        "StateUpdate": { "$className": "RemoteEvent" },
        "Notice": { "$className": "RemoteEvent" },
        "FloorEntered": { "$className": "RemoteEvent" },
        "RunEnded": { "$className": "RemoteEvent" },
        "Effect": { "$className": "RemoteEvent" }
      }
    },

    "ServerScriptService": {
      "Server": {
        "$path": "src/server"
      }
    },

    "StarterPlayer": {
      "$properties": {
        "CameraMaxZoomDistance": 90,
        "CameraMinZoomDistance": 20,
        "CharacterWalkSpeed": 14,
        "CharacterUseJumpPower": false,
        "CharacterJumpHeight": 0,
        "EnableMouseLockOption": false
      },
      "StarterPlayerScripts": {
        "Client": {
          "$path": "src/client"
        }
      }
    },

    "Workspace": {
      "$properties": {
        "FilteringEnabled": true
      }
    },
    "Lighting": {
      "$properties": {
        "Ambient": [0.07, 0.06, 0.06],
        "OutdoorAmbient": [0.05, 0.05, 0.06],
        "Brightness": 0,
        "ClockTime": 0,
        "EnvironmentDiffuseScale": 0,
        "EnvironmentSpecularScale": 0,
        "GlobalShadows": true,
        "Outlines": false,
        "FogColor": [0.02, 0.02, 0.025],
        "FogStart": 70,
        "FogEnd": 160
      }
    },
    "SoundService": {
      "$properties": {
        "RespectFilteringEnabled": true
      }
    }
  }
}
